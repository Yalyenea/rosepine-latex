set shell := ["bash", "-lc"]

name := `basename "$PWD"`
flags_en := "-pdf -interaction=nonstopmode -halt-on-error"
flags_zh := "-xelatex -interaction=nonstopmode -halt-on-error"

default:
  @just --list

build-en:
  mkdir -p .tmp/en build
  latexmk {{flags_en}} -outdir=.tmp/en main.tex
  cp .tmp/en/main.pdf build/{{name}}-en.pdf

build-zh:
  mkdir -p .tmp/zh build
  latexmk {{flags_zh}} -outdir=.tmp/zh main_zh.tex
  cp .tmp/zh/main_zh.pdf build/{{name}}-zh.pdf

build:
  #!/usr/bin/env bash
  set -euo pipefail
  if [[ -f main.tex ]]; then just build-en; fi
  if [[ -f main_zh.tex ]]; then just build-zh; fi

clean:
  rm -rf .tmp

cleanall: clean
  rm -rf build
